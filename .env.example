# --- Required ---
MAIN_BOT_TOKEN=123456:ABC-your-main-bot-token
# Comma separated Telegram numeric IDs of the admins (super users)
OWNER_IDS=111111111,222222222

# --- Optional ---
# Where the database lives. On Railway attach a Volume and point this to it (e.g. /data)
DATA_DIR=data
# Fernet key used to encrypt bot tokens at rest. If empty, a key file is generated in DATA_DIR.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Is the service (admin-owned reaction bots) open to everybody? (can be toggled from the admin panel)
SERVICE_PUBLIC=false
# Shown to users who have no access to the service, e.g. @YourSupport
SUPPORT_CONTACT=

MAX_TARGETS_PER_USER=5
MAX_BOTS_PER_USER=10
REACTIONS_TTL=300
MAX_CONCURRENCY=20
LOG_LEVEL=INFO
# Old v1 state file; imported once automatically if it exists
STATE_FILE=state.json
